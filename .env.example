# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database
MONGO_URI=mongodb://127.0.0.1:27017/twh_db

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false

# SMTP (email - forgot password, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="TheWebHero <no-reply@thewebhero.com>"

# Uploads
MAX_UPLOAD_SIZE_MB=10

# Cloudinary (media library - get these from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=thewebhero

# AI SEO generation (OpenAI primary, Gemini fallback) - optional
OPENAI_API_KEY=
GEMINI_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Seed (initial super admin)
SEED_ADMIN_EMAIL=admin@thewebhero.com
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Super Admin
